{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "preDeployCommand": "npx prisma db push --skip-generate && node prisma/seed.js",
    "startCommand": "npm start",
    "healthcheckPath": "/login",
    "restartPolicyType": "ON_FAILURE"
  }
}
